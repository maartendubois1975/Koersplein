{
  "version": 3,
  "mission": "Koersplein onderzoekt zelfstandig welke herhaalbare signalen en marktritmes voorafgaan aan toekomstige koerskansen. Iedere afgeronde analyse moet zelf nieuwe toetsbare onderzoeksideeën voorstellen; het systeem wacht daarvoor niet op handmatige ideeën.",
  "researchPolicy": {
    "proactiveResearch": true,
    "generateNextExperiments": true,
    "minimumNewHypothesesPerCompletedResearchCycle": 3,
    "hypothesesMustBeTestable": true,
    "challengeOwnHypotheses": true,
    "requireControlGroups": true,
    "requireOutOfSampleValidation": true,
    "preventFutureLeakage": true,
    "freezePredictionsBeforeScoring": true,
    "crossMarketValidation": true,
    "researchQuestion": "Welke kenmerken, volgordes en marktritmes waren vóór een koersbeweging zichtbaar en blijven voorspellend op een markt waarop ze niet ontdekt zijn?",
    "priorityThemes": [
      "voorlopers van +10%, +20%, +30%, +50% en +100% bewegingen",
      "momentum en versnelling over dagen, weken en maanden",
      "consolidatie, terugval, herstel en trendbreuken",
      "volatiliteit en drawdown vóór winnaar en niet-winnaar",
      "herhaaldelijke winnaars versus eenmalige uitschieters",
      "marktregimes en clustering van gelijktijdige kansen",
      "volgordes zoals +10%, terugval, consolidatie en verdere versnelling",
      "verschillen tussen Amsterdam, Brussel en volgende blinde markten"
    ],
    "experimentLifecycle": [
      "OBSERVE_RESULT",
      "GENERATE_HYPOTHESES",
      "DEFINE_CONTROL_GROUP",
      "BACKTEST_POINT_IN_TIME",
      "FREEZE_RULE_OR_MODEL",
      "BLIND_CROSS_MARKET_TEST",
      "REJECT_OR_KEEP",
      "PROPOSE_NEXT_EXPERIMENTS"
    ],
    "ideaOutput": {
      "required": true,
      "fields": [
        "hypothesis",
        "why_now",
        "test_design",
        "success_metric",
        "falsification_condition",
        "next_market"
      ],
      "storePerMarket": true,
      "storeCrossMarket": true
    }
  },
  "afterMarketValidation": [
    {
      "machine": "M01",
      "name": "Data Truth",
      "required": true
    },
    {
      "machine": "M02",
      "name": "Opportunity Map",
      "required": true
    },
    {
      "machine": "M03",
      "name": "Time Machine",
      "required": true
    },
    {
      "machine": "M04",
      "name": "Feature Factory",
      "required": true
    },
    {
      "machine": "M05",
      "name": "Model Arena",
      "required": true,
      "freezePredictions": true
    },
    {
      "machine": "M06",
      "name": "Judge / Statistical Guard",
      "required": true,
      "mutationForbidden": true
    },
    {
      "machine": "M07",
      "name": "Blind World Test",
      "required": true,
      "blindMarket": true
    },
    {
      "machine": "M08",
      "name": "Live Opportunity Scanner",
      "required": false,
      "activateOnlyAfterValidatedPatterns": true
    },
    {
      "machine": "M09",
      "name": "Drift & Execution Monitor",
      "required": true
    },
    {
      "machine": "M10",
      "name": "Hindsight / Post-Mortem",
      "required": true,
      "mayGenerateHypotheses": true,
      "promotionForbidden": true
    }
  ],
  "crossMarketProgram": {
    "discoveryMarkets": [
      "XAMS",
      "XBRU"
    ],
    "crossTests": [
      "XAMS_TO_XBRU",
      "XBRU_TO_XAMS"
    ],
    "nextBlindMarket": "XPAR",
    "combineDiscoveryOnlyAfterSeparateResultsStored": true
  },
  "promotionRule": "market COMPLETE only after M01 data validation; research never mutates historical predictions; M10 hindsight may generate hypotheses but only PRE_VISIBLE candidates may return through M03/M04 and must survive M05/M06/M07 before promotion",
  "publication": {
    "perMarket": true,
    "crossMarketComparison": true,
    "proprietaryModelHidden": true,
    "showResearchAgenda": true,
    "showHighLevelHypotheses": true
  },
  "architecture": "M01-M10"
}
