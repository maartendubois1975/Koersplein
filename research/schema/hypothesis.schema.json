{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Koersplein Research Hypothesis",
  "type":"object",
  "required":["id","family","status","question"],
  "properties":{
    "id":{"type":"string"},
    "family":{"type":"string"},
    "status":{"type":"string","enum":["CAPTURED","SPECIFIED","DATA_READY","BACKTEST_REQUESTED","BACKTESTED","OOS_VALIDATED","REPLICATED","CANDIDATE_SIGNAL","REJECTED"]},
    "question":{"type":"string"},
    "pointInTimeDataRequired":{"type":"array","items":{"type":"string"}},
    "purpose":{"type":"string"}
  },
  "additionalProperties":true
}
